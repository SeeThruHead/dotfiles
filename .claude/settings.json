{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit"
    ],
    "deny": [
      "Agent(Explore)",
      "Agent(Plan)",
      "Agent(general-purpose)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/shanekeulen/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "probity@probity": false
  },
  "extraKnownMarketplaces": {
    "probity": {
      "source": {
        "source": "github",
        "repo": "nizos/probity"
      }
    }
  },
  "outputStyle": "Concise",
  "spinnerTipsEnabled": false,
  "effortLevel": "medium",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "permissionMode": "bypassPermissions"
}
